function cfd_coursework_project_list() {
    $existing_coursework_projects = [];
    $connection = \Drupal::database();

    $proposal_titles = $connection->select('coursework_project_proposal', 'csp')
        ->fields('csp', ['project_title'])
        ->condition('approval_status', [0, 1, 3], 'IN');

    $query = $connection->select('coursework_project_titles', 'lpt')
        ->fields('lpt', ['project_title_name']);
    $query->condition('project_title_name', $proposal_titles, 'NOT IN');

    $result = $query->execute();
    while ($coursework_project_list_data = $result->fetchObject()) {
        $existing_coursework_projects[$coursework_project_list_data->project_title_name] = $coursework_project_list_data->project_title_name;
    }

    return $existing_coursework_projects;
}

function cfd_coursework_project_list_versions(){
    $versions = array();
    $query = \Drupal::database()->select('coursework_project_software_version');
    $query->fields('coursework_project_software_version');
    $version_list = $query->execute();
    while($version_data = $version_list->fetchObject()){
        $versions[$version_data->id] = $version_data->case_study_version;
    }
    return $versions;
}

