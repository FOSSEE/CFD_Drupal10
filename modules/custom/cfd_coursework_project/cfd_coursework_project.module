/**
 * Validates an uploaded filename.
 */
function cfd_coursework_project_check_valid_filename($file_name)
{
    if (!preg_match('/^[0-9a-zA-Z\.\_]+$/', $file_name)) {
        return false;
    } else if (substr_count($file_name, ".") > 1) {
        return false;
    } else {
        return true;
    }

}
function cfd_coursework_project_check_name($name = '')
{
    if (!preg_match('/^[0-9a-zA-Z\ ]+$/', $name)) {
        return false;
    } else {
        return true;
    }

}
function cfd_coursework_project_check_code_number($number = '')
{
    if (!preg_match('/^[0-9]+$/', $number)) {
        return false;
    } else {
        return true;
    }

}
